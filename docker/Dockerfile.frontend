# ── Stage 1: Build React/Vite Application ─────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# Copy root workspace configurations for monorepo resolution
COPY package.json package-lock.json ./
COPY frontend/package.json ./frontend/

# Install dependencies using workspace context
RUN npm ci

# Copy frontend source code
COPY frontend ./frontend

# Build static bundle
WORKDIR /app/frontend
RUN npm run build

# ── Stage 2: Serve Bundle with Nginx ──────────────────────────────────────────
FROM nginx:alpine

# Copy custom Nginx configuration to support single page app routing
COPY docker/nginx-frontend.conf /etc/nginx/conf.d/default.conf

# Copy build folder to public directory
COPY --from=builder /app/frontend/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
