@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  :root {
    --scrollbar-w: 6px;
  }

  * {
    scrollbar-width: thin;
    scrollbar-color: #1e3a6e transparent;
  }

  *::-webkit-scrollbar { width: var(--scrollbar-w); height: var(--scrollbar-w); }
  *::-webkit-scrollbar-track { background: transparent; }
  *::-webkit-scrollbar-thumb { background: #1e3a6e; border-radius: 99px; }

  body {
    @apply bg-slate-50 text-black font-sans relative min-h-screen overflow-x-hidden;
    font-feature-settings: 'ss01','ss02','cv01','cv02';
  }

  body::before, body::after {
    content: '';
    position: fixed;
    border-radius: 50%;
    z-index: -10;
    filter: blur(80px);
    opacity: 0.6;
    animation: floatBlob 15s ease-in-out infinite alternate;
  }
  
  body::before {
    top: -10%; left: -10%;
    width: 500px; height: 500px;
    background: linear-gradient(135deg, #a8c0ff 0%, #3f2b96 100%);
  }

  body::after {
    bottom: -10%; right: -10%;
    width: 600px; height: 600px;
    background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 100%);
    animation-delay: -5s;
  }

  @keyframes floatBlob {
    0% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(100px, 50px) scale(1.1); }
    100% { transform: translate(-50px, 150px) scale(0.9); }
  }

  input, textarea, select {
    @apply outline-none;
  }

  ::selection {
    @apply bg-brand-600 text-white;
  }
}

@layer components {
  .glass-card {
    @apply bg-white/80 backdrop-blur-xl border border-white rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.04)];
  }

  .glass-card-light {
    @apply bg-white/60 backdrop-blur-lg border border-white/80 rounded-2xl shadow-sm;
  }

  .nav-item {
    @apply flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-semibold
           text-black hover:text-brand-600 hover:bg-white
           transition-all duration-150 cursor-pointer;
  }

  .nav-item.active {
    @apply text-brand-700 bg-white shadow-sm border border-brand-100;
  }

  .btn-primary {
    @apply inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-sm font-semibold
           bg-brand-600 hover:bg-brand-700 text-white
           transition-all duration-150 active:scale-[.98]
           disabled:opacity-50 disabled:cursor-not-allowed;
  }

  .btn-secondary {
    @apply inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-sm font-bold
           bg-white hover:bg-slate-50 border border-slate-200 shadow-sm
           text-slate-700 transition-all duration-150 active:scale-[.98];
  }

  .btn-danger {
    @apply inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-sm font-bold
           bg-danger-600 hover:bg-danger-500/90 text-white
           transition-all duration-150 active:scale-[.98] shadow-md shadow-danger-500/20;
  }

  .input-field {
    @apply w-full bg-white border border-slate-200 rounded-xl px-4 py-3
           text-black placeholder-slate-400 text-sm shadow-sm
           focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20
           transition-all duration-150;
  }

  .textarea-field {
    @apply w-full bg-white border border-slate-200 rounded-xl px-4 py-3
           text-black placeholder-slate-400 text-sm font-mono shadow-sm
           focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20
           transition-all duration-150 resize-none;
  }

  .label {
    @apply block text-sm font-bold text-black mb-1.5;
  }

  .badge-phishing {
    @apply inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold
           bg-danger-600/20 text-danger-400 border border-danger-500/20;
  }

  .badge-legit {
    @apply inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold
           bg-safe-500/20 text-safe-400 border border-safe-500/20;
  }

  .badge-suspicious {
    @apply inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold
           bg-warn-500/20 text-warn-400 border border-warn-400/20;
  }

  .flag-red {
    @apply inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-xs
           bg-danger-600/15 text-danger-400 border border-danger-500/20;
  }

  .flag-green {
    @apply inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-xs
           bg-safe-500/15 text-safe-400 border border-safe-500/20;
  }

  .score-bar-track {
    @apply h-1.5 rounded-full bg-white/[0.08] overflow-hidden;
  }

  .divider {
    @apply border-t border-slate-200;
  }

  .page-title {
    @apply text-2xl font-extrabold text-black tracking-tight;
  }

  .page-sub {
    @apply text-sm font-medium text-black/70 mt-0.5;
  }

  .section-title {
    @apply text-base font-bold text-black mb-1;
  }

  .table-th {
    @apply px-4 py-3 text-left text-xs font-bold text-black/60 uppercase tracking-wider;
  }

  .table-td {
    @apply px-4 py-3.5 text-sm font-medium text-black;
  }
}

@layer utilities {
  .text-gradient {
    @apply bg-clip-text text-transparent bg-gradient-brand;
  }
  
  .bg-mesh {
    background-image: radial-gradient(at 40% 20%, rgba(59,130,246,.08) 0, transparent 50%),
                      radial-gradient(at 80% 0%, rgba(124,58,237,.06) 0, transparent 50%);
  }
}

@keyframes scan {
  0% { top: 0%; }
  50% { top: 100%; }
  100% { top: 0%; }
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-20px); }
}
