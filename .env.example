# ── Application ────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=False
APP_NAME="PhishGuard UK"
APP_VERSION=1.0.0

# ── Database ───────────────────────────────────────────────────────────────
# format: postgresql+driver://user:password@host/dbname
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/phishguard
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/phishguard

# ── Auth / JWT ─────────────────────────────────────────────────────────────
SECRET_KEY=your_long_random_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ───────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:5173", "https://localhost:3000", "http://localhost:3000"]

# ── ML Models ──────────────────────────────────────────────────────────────
MODEL_DIR=../ml/models
XGB_MODEL_PATH=../ml/models/xgb_model.pkl
EMAIL_MODEL_PATH=../ml/models/email_model.pkl
TFIDF_VECTORIZER_PATH=../ml/models/tfidf_vectorizer.pkl
SHAP_EXPLAINER_PATH=../ml/models/shap_explainer.pkl
FEATURE_NAMES_PATH=../ml/models/feature_names.json

# ── Email / SMTP (Brevo relay) ─────────────────────────────────────────────
# Using Brevo (formerly Sendinblue) SMTP relay for transactional emails.
# Login to https://app.brevo.com → Senders & IPs → Add a verified sender.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=your_brevo_login@smtp-brevo.com
SMTP_PASSWORD=your_brevo_api_key
EMAILS_FROM=your_verified_sender@example.com
EMAILS_FROM_NAME=PhishGuard UK
OTP_EXPIRE_MINUTES=15

# ── Frontend base URL (used in email deep-links) ───────────────────────────
FRONTEND_BASE_URL=http://localhost:5173

# ── External AI Fallback (Ollama) ─────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi3

# ── Gemini API (Google AI Studio) ─────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
